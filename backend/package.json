{
  "name": "medivault-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Single-doctor patient records API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests docs README.md package.json tsconfig.json",
    "format:check": "prettier --check src tests docs README.md package.json tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.cjs",
    "seed:demo": "tsx src/scripts/seedDemo.ts",
    "doctor:setup": "tsx src/scripts/setupDoctor.ts",
    "workspace:migrate": "tsx src/scripts/migrateWorkspace.ts"
  },
  "dependencies": {
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3"
  }
}
