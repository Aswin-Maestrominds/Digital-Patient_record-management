# Copy to .env inside backend. Never commit .env or use demo accounts for real data.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
DATABASE_URL=mongodb://127.0.0.1:27017/medivault_demo

# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back up this key separately from the database and files. Losing it loses access.
DOCUMENT_ENCRYPTION_KEY=
SESSION_HOURS=8
# Set only to the exact number of trusted reverse proxies; never expose that backend directly.
TRUST_PROXY_HOPS=0

# local or cloudinary. Local files require a persistent encrypted disk in deployment.
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads/clinical_vault
MAX_FILE_SIZE_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set these in your shell/secret manager for npm run doctor:setup.
# DOCTOR_NAME=
# DOCTOR_EMAIL=
# DOCTOR_PASSWORD=
# ROTATE_DOCTOR_CREDENTIALS=false
